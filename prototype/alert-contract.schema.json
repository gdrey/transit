{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved GTFS alert check",
  "description": "A model or person supplies the interpretation. IDs must come from the current feed; time windows must be explicit local civil times. This contract does not itself prove the interpretation is correct.",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_type", "route_id", "direction_id", "stop_ids", "timezone", "windows"],
  "properties": {
    "change_type": {"const": "stops_skipped"},
    "route_id": {"type": "string", "minLength": 1},
    "direction_id": {"type": "string", "enum": ["0", "1"]},
    "stop_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "timezone": {"type": "string", "minLength": 1},
    "windows": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "description": "Local wall time YYYY-MM-DDTHH:MM:SS, inclusive"}, "end": {"type": "string", "description": "Local wall time YYYY-MM-DDTHH:MM:SS, exclusive"}}}}
  }
}
